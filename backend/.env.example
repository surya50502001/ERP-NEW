# Prime ERP ASP.NET Core Backend Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__ErpDb=Server=sqlserver,1433;Database=ERP;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;

# JWT Authentication Security
Jwt__SecretKey=PRIME_ERP_PRODUCTION_JWT_SECRET_KEY_FOR_AUTHENTICATION_2026_ENTERPRISE_SECURE_TOKEN!
Jwt__Issuer=PrimeErpApi
Jwt__Audience=PrimeErpClient
Jwt__ExpireDays=7

# CORS Allowed Origins (Comma-separated or indexed)
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
Cors__AllowedOrigins__2=https://erp.yourdomain.com

